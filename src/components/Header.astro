---
import { SITE_NAME } from '../data/constants';

// The name is the page heading on the homepage only; other pages have their own
const isHome = Astro.url.pathname === '/';
const Heading = isHome ? 'h1' : 'p';
---

<header class="mb-20 w-full sm:mb-24">
  <Heading class="font-medium">
    <a class="w-fit" href="/">{SITE_NAME}</a>
  </Heading>
</header>
