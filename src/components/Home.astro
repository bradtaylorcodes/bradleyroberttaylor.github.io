---
import { EMAIL, GITHUB_URL, LINKEDIN_URL } from '../data/constants';
import { getPosts, postUrl } from '../data/posts';
import { PROJECTS } from '../data/projects';
import ExternalLink from './ExternalLink.astro';
import ListItem from './ListItem.astro';
import Section from './Section.astro';

const posts = await getPosts();

const linkClass =
  'text-neutral-900 underline decoration-neutral-300 underline-offset-2 transition-colors hover:decoration-neutral-900 dark:text-white dark:decoration-neutral-600 dark:hover:decoration-white';
---

<div class="flex flex-col gap-16 sm:gap-24">
  <Section>
    <p class="text-neutral-500 dark:text-neutral-400">
      I'm a software engineer who cares about making software easy to use, both
      for the developers who build on it and the people who rely on it.
      Previously, I worked on Atlassian's Admin Experience team, improving
      high-traffic APIs, service reliability and developer workflows.
    </p>
  </Section>

  <Section title="Now">
    <p class="text-neutral-500 dark:text-neutral-400">
      Right now I'm learning how to build AI into applications: working with
      model APIs, designing for responses that aren't always the same, and
      making AI features feel reliable to the people using them.
    </p>
  </Section>

  <Section title="Projects">
    <ul class="flex flex-col">
      {
        PROJECTS.map(({ name, description, href }) => (
          <ListItem
            href={href}
            title={name}
            description={description}
            external
          />
        ))
      }
    </ul>
  </Section>

  {
    posts.length > 0 && (
      <Section title="Writing">
        <ul class="flex flex-col">
          {posts.map(({ id, data }) => (
            <ListItem
              href={postUrl(id)}
              title={data.title}
              description={data.description}
              date={data.date}
            />
          ))}
        </ul>
      </Section>
    )
  }

  <Section title="Connect">
    <p class="text-neutral-500 dark:text-neutral-400">
      The best way to reach me is by <a
        class={linkClass}
        href={`mailto:${EMAIL}`}>email</a
      >. You can also find me on <ExternalLink
        class={linkClass}
        href={LINKEDIN_URL}>LinkedIn</ExternalLink
      > or see what I'm building on <ExternalLink
        class={linkClass}
        href={GITHUB_URL}>GitHub</ExternalLink
      >.
    </p>
  </Section>
</div>
