---
import ExternalLink from './ExternalLink.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  date?: Date;
  external?: boolean;
}

const { href, title, description, date, external = false } = Astro.props;

const Link = external ? ExternalLink : 'a';
---

<li>
  <Link
    class="-mx-3 flex flex-col rounded-md px-3 py-2 transition-colors hover:bg-neutral-100 dark:hover:bg-neutral-900"
    href={href}
  >
    <span class="flex items-baseline justify-between gap-4">
      <span class="font-medium text-neutral-900 dark:text-white">{title}</span>
      {
        date && (
          <FormattedDate
            class="shrink-0 text-sm text-neutral-500 dark:text-neutral-400"
            date={date}
            format="short"
          />
        )
      }
    </span>
    <span class="text-neutral-500 dark:text-neutral-400">{description}</span>
  </Link>
</li>
