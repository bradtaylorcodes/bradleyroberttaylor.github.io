---
import { GITHUB_URL, EMAIL, LINKEDIN_URL } from '../data/constants';

export const FOOTER_LINKS = [
  {
    href: `mailto:${EMAIL}`,
    name: 'email',
  },
  {
    href: '/resume.pdf',
    name: 'resume',
    newTab: true,
  },
  {
    href: LINKEDIN_URL,
    name: 'linkedin',
    newTab: true,
  },
  {
    href: GITHUB_URL,
    name: 'github',
    newTab: true,
  },
];
---

<footer class="w-full">
  <nav aria-label="Contact and profile links">
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-3">
      {
        FOOTER_LINKS.map(({ href, name, newTab }) => (
          <li>
            <a
              class="text-medium text-neutral-500 transition-colors hover:text-black dark:text-neutral-400 dark:hover:text-inherit"
              target={newTab ? '_blank' : undefined}
              rel={newTab ? 'noopener noreferrer' : undefined}
              href={href}
            >
              {name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</footer>
