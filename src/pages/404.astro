---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Bradley Taylor"
  description="The requested page could not be found."
  noindex
>
  <main
    id="main-content"
    class="flex min-h-screen items-center justify-center px-6"
  >
    <div class="space-y-2 text-center">
      <h1 class="text-4xl">404</h1>
      <p>This page doesn't exist</p>
      <a
        href="/"
        class="text-medium text-neutral-400 transition-colors hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-inherit"
        >Go back home</a
      >
    </div>
  </main>
</BaseLayout>
